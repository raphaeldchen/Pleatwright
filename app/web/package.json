{
  "name": "pleatwright-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build",
    "build:site": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && vite build --mode site",
    "check:site": "node scripts/check-site.mjs",
    "test": "vitest run",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "bundle-py": "node -e \"require('node:child_process').execFileSync(process.env.PYTHON||'python3',['../browser/bundle_py.py','public-site/py.zip'],{stdio:'inherit'})\"",
    "e2e:prepare": "node scripts/e2e-prepare.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "pyodide": "314.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
