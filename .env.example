# Pleatwright -- environment configuration template.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. `python -m pleatwright author|run` loads it at
# startup (mcp_harness/env_config.py); that needs python-dotenv:
#
#     pip install python-dotenv
#
# Real shell-exported vars always override `.env`, so you can still do:
#     ANTHROPIC_API_KEY=... python -m pleatwright author "a dog" --out DIR
#
# `python -m pleatwright fold` reads none of these: folding a tree needs no key.
# Every variable below is read by the code on main; nothing else is.

# ===========================================================================
# VLM tree authoring -- llm_client.LLMConfig.from_env
# ===========================================================================
# The authoring provider. `claude` is the one the authoring path is built and
# tested against (llm_client also keeps groq | gemini | ollama presets).
LLM_PROVIDER=claude

# Required for `author` / `run`. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Only for an identity-linked key, which every endpoint rejects without the
# `anthropic-workspace-id` header; a classic org key ignores it. Leave empty
# otherwise.
ANTHROPIC_WORKSPACE_ID=

# The authoring budget. Authoring REFUSES to run below 64000
# (gated_pipeline.REQUIRED_MAX_TOKENS): these trees finish near 32,000
# completion tokens. The CLI sets 64000 when this is unset.
LLM_MAX_TOKENS=64000

# Optional overrides (defaults come from the provider preset). The claude
# preset defaults to claude-sonnet-5; set LLM_MODEL=claude-haiku-5-5 to make the
# CLI author with Haiku (cheaper). The app ignores LLM_MODEL: its model pill picks per action.
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=
# Leave LLM_TEMPERATURE unset: claude-sonnet-5 refuses the parameter (400).
# LLM_TEMPERATURE=

# ===========================================================================
# Mesh provider (text -> concept image -> mesh) -- mesh_acquire.get_provider
# ===========================================================================
# One of:
#   fake  -- offline fixture meshes, no network or key. The code default.
#   hf2   -- two stages: a concept image (Nano Banana 2.1 when GEMINI_API_KEY
#            is set, else FLUX.1-schnell on HuggingFace), then a Hunyuan3D-2
#            mesh on HuggingFace. The live text -> mesh path.
#   hf    -- one free text-to-3D Space (Shap-E by default).
#   meshy -- paid hosted text-to-3D; needs MESHY_API_KEY.
MESH_PROVIDER=fake

# hf / hf2: OPTIONAL, but raises the free GPU quota.
# https://huggingface.co/settings/tokens
HF_TOKEN=
# hf2's concept image (mesh_acquire.hf2_image_backend). Nano Banana 2.1 is a
# PAID Gemini model: about $0.042 an image; the free tier's image quota is 0,
# so a free-tier key fails with a message saying so. The same key serves
# LLM_PROVIDER=gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# MESH_IMAGE_BACKEND=auto     # auto (Gemini with a key, else FLUX) | gemini | flux
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# hf2 Space overrides (defaults in mesh_acquire.DEFAULT_HF_*; the image ones
# apply to the FLUX backend only):
# HF_IMAGE_SPACE_ID=black-forest-labs/FLUX.1-schnell
# HF_IMAGE_API=/infer
# HF_MESH_SPACE_ID=tencent/Hunyuan3D-2
# HF_MESH_API=/shape_generation
# hf Space overrides:
# HF_SPACE_ID=hysts/Shap-E
# HF_API_NAME=/text-to-3d      # verify via gradio_client Client(space).view_api()

# meshy only. https://www.meshy.ai/ (paid)
MESHY_API_KEY=

# Where generated meshes are cached (default mcp_harness/generated_meshes,
# gitignored). Keep it COMMENTED unless you set a path: an empty value is read
# as "" (the current directory), not as "use the default".
# MESH_OUTPUT_DIR=mcp_harness/generated_meshes

# app: a library of reference meshes, one per subject, laid out as
# meshes/<subject>.glb beside photos/<subject>.png (`_` reads as a space, so
# guinea_pig.glb answers "a guinea pig"). A run of a library subject is served
# its reference mesh first, with the photo as its concept image; feedback on it
# draws from MESH_PROVIDER as usual. Unset: no library.
# MESH_LIBRARY_DIR=/path/to/photo_meshes

# Provenance sidecars (meta.json beside each cached mesh) are written by
# default; the value 0 turns them off.
# IDE_MESH_PROVENANCE=0

# app: where runs are stored (default ~/Pleatwright/runs)
# PLEATWRIGHT_RUNS_DIR=
